{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "prisma.config.ts",
    "seed.ts",
    "seed_constants/**/*.ts",
    "db_operations/**/*.ts"
  ]
}
